theme = Kali
auto-update-channel = tip

# Text
font-family = "JetBrains Mono Nerd Font"
font-size = 16
font-thicken = true
bold-color = bright

# Background
background-opacity = 0.75
background-blur = 30

# Colors
window-colorspace = display-p3

# Cursor
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

